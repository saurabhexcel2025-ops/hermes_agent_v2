# ═══════════════════════════════════════════════
# Hermes — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Ollama Cloud (https://ollama.com/settings) ──
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_LLM_MODEL=glm-5
# Other available models: kimi-k2.6, qwen3.5

# ── Domain (nginx + certbot) ──
DOMAIN=mc.spacearmour.io

# ── Control Hub ──
NEXT_PUBLIC_APP_URL=https://mc.spacearmour.io

# ── Control Hub Auth (generate with: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── Data services (generate with: openssl rand -hex 24) ──
# Postgres user/db are fixed (hermes / hermes_auth); only the password is secret.
POSTGRES_PASSWORD=your_postgres_password_here
# Neo4j user is fixed (neo4j); only the password is secret.
NEO4J_PASSWORD=your_neo4j_password_here

# ── Mem0 ──
MEM0_USER_ID=hermes-user

# ── Hermes Gateway (API server on port 8642) ──
# HERMES_GATEWAY_API_KEY must match API_SERVER_KEY in ~/.hermes/.env
# Generate with: openssl rand -hex 32
HERMES_GATEWAY_API_KEY=your_gateway_api_key_here

# ── Sentinel (autonomous ops — runs inside the mem0-server container) ──
# Target server Sentinel monitors over SSH. Leave HOST empty to probe locally.
SENTINEL_TARGET_HOST=
SENTINEL_TARGET_USER=root
SENTINEL_TARGET_PORT=22
# Private key for the target, placed at sentinel/id_target (chmod 600, gitignored).
SENTINEL_SSH_KEY=/data/sentinel/id_target
SENTINEL_POLL_SECONDS=10
SENTINEL_CYCLE_SECONDS=5
