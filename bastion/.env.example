# ── Target server Bastion watches (SSH) ────────────────────────────
# Same server Sentinel watches. Leave BASTION_TARGET_HOST empty to read the
# LOCAL host's sshd logs (dev/testing).
BASTION_TARGET_HOST=
BASTION_TARGET_USER=etech
BASTION_TARGET_PORT=22
# Private key used to SSH into the target (mounted into the container).
# Can reuse Sentinel's key if it's the same target/user.
BASTION_SSH_KEY=/data/bastion/id_target

# ── Detection rule ─────────────────────────────────────────────────
BASTION_ATTEMPTS=5            # > this many attempts ...
BASTION_WINDOW_SECONDS=60     # ... within this window trips a block
BASTION_BLOCK_SECONDS=300     # block duration (ipset timeout + VPC rule) = 5 minutes
BASTION_CRITICAL_FACTOR=2.0   # CRITICAL at >= 2x the threshold
BASTION_LOOKBACK_SECONDS=90   # how far back each log poll reads (dedup makes overlap safe)

# ── Cadence ────────────────────────────────────────────────────────
BASTION_POLL_SECONDS=5        # collector: read sshd logs
BASTION_CYCLE_SECONDS=5       # cycle: aggregate + block

# ── Whitelist — IPs/CIDRs that are NEVER blocked ───────────────────
# Private ranges + loopback are ALWAYS included by default (the monitoring SSH
# uses the internal 10.x address). Add your PUBLIC admin IP(s) here so you never
# lock yourself out. Comma-separated CIDRs or bare IPs.
BASTION_WHITELIST=

# ── Enforcement ────────────────────────────────────────────────────
BASTION_IPSET_NAME=bastion_block
BASTION_SUDO=sudo            # set empty if the target user runs ipset without sudo

# ── VPC edge enforcement (defense-in-depth) ────────────────────────
# When enabled, Bastion also creates an INGRESS DENY firewall rule for the
# attacker /32 (tcp:22) in the target's GCP project, dropping it at the network
# edge. Needs a service-account key with firewalls.create/delete. The cycle's
# sweeper deletes the rule on expiry (VPC rules have no TTL).
BASTION_VPC_ENABLE=false
BASTION_GCP_PROJECT=mission-control-497604
BASTION_GCP_NETWORK=default
BASTION_GCP_SA_KEY=/data/bastion/gcp-fw-sa.json
BASTION_VPC_PRIORITY=100      # must beat default-allow-ssh (priority 65534)

# ── Postgres (defaults match docker-compose mem0-server) ───────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hermes_auth
POSTGRES_USER=hermes
POSTGRES_PASSWORD=

# ── Embeddings (local — same model mem0 uses) ──────────────────────
BASTION_EMBED_MODEL=multi-qa-MiniLM-L6-cos-v1

# ── Reasoning (Hermes gateway, glm-5) ──────────────────────────────
HERMES_GATEWAY_URL=http://host.docker.internal:8642
HERMES_GATEWAY_API_KEY=
BASTION_MODEL=glm-5

# ── Hindsight (knowledge graph mirror) ─────────────────────────────
HINDSIGHT_BASE_URL=http://host.docker.internal:9177
HINDSIGHT_BANK_ID=hermes
