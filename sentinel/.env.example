# ── Target server Sentinel monitors (SSH) ──────────────────────────
# Leave SENTINEL_TARGET_HOST empty to probe the LOCAL host (dev/testing).
SENTINEL_TARGET_HOST=
SENTINEL_TARGET_USER=root
SENTINEL_TARGET_PORT=22
# Path to the private key used to SSH into the target (mounted into the container).
SENTINEL_SSH_KEY=/data/sentinel/id_target

# ── Cadence ────────────────────────────────────────────────────────
SENTINEL_POLL_SECONDS=10
SENTINEL_CYCLE_SECONDS=5

# ── Postgres (defaults match docker-compose mem0-server) ───────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hermes_auth
POSTGRES_USER=hermes
POSTGRES_PASSWORD=

# ── Embeddings (Ollama Cloud — same provider as the LLM) ───────────
# Uses OLLAMA_CLOUD_API_KEY + OLLAMA_CLOUD_BASE_URL (already set on mem0-server).
SENTINEL_EMBED_MODEL=nomic-embed-text

# ── Reasoning (Hermes gateway, glm-5) ──────────────────────────────
HERMES_GATEWAY_URL=http://host.docker.internal:8642
HERMES_GATEWAY_API_KEY=
SENTINEL_MODEL=glm-5

# ── Hindsight (knowledge graph mirror) ─────────────────────────────
HINDSIGHT_BASE_URL=http://host.docker.internal:9177
HINDSIGHT_BANK_ID=hermes
